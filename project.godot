config_version=5

[application]
config/name="Ilha das Cinzas - V4"
run/main_scene="res://main.tscn"
run/main_scene.template="res://jogo_ilha.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="IlhaDasCinzasPrototype"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.055,0.07,0.10,1)

[autoload]
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

[physics]
common/physics_interpolation=true

[phantom_camera]
jitter/show_tips=false

[shader_globals]
sgt_legacy_renderer={"type":"int","value":0}
sgt_player_position={"type":"vec3","value":Vector3(1000000,1000000,1000000)}
sgt_player_mov={"type":"vec3","value":Vector3(0,0,0)}
sgt_normal_displacement={"type":"sampler2D","value":"res://addons/simplegrasstextured/images/normal.png"}
sgt_motion_texture={"type":"sampler2D","value":"res://addons/simplegrasstextured/images/motion.png"}
sgt_wind_direction={"type":"vec3","value":Vector3(1,0,0)}
sgt_wind_movement={"type":"vec3","value":Vector3(0,0,0)}
sgt_wind_strength={"type":"float","value":0.15}
sgt_wind_turbulence={"type":"float","value":1.0}
sgt_wind_pattern={"type":"sampler2D","value":"res://addons/simplegrasstextured/images/wind_pattern.png"}
